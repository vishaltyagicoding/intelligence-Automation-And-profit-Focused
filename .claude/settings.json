  "important_notes": {
    "container_name": "django (NOT 'backend')",
    "env_file": ".env (NOT .env.production)",
    "docker_compose": "docker-compose.yml (NOT docker-compose.prod.yml)",
    "token_name": "access_token (NOT 'auth_token')",
    "binance_api": "api.binance.us (NOT api.binance.com)"
  },
  "signal_calculation": {
    "buy": {
      "entry": "center_price",
      "target": "outer_top",
      "calculate": "target - entry",
      "stoploss": "entry - (calculate * 0.5)"
    },
    "sell": {
      "entry": "center_price",
      "target": "outer_bottom",
      "calculate": "entry - target",
      "stoploss": "target + (calculate * 0.5)"
    }
  },
  "anti_chop_filter": {
    "min_time_gap": "1 hour",
    "alternation": "strict (BUY → SELL → BUY)"
  }
}
