{
  "local_development": {
    "frontend": { "url": "http://localhost:3000", "command": "npm run dev" },
    "backend":  { "url": "http://localhost:8000", "command": "python manage.py runserver 0.0.0.0:8000" },
    "database": { "host": "localhost", "port": 5432, "name": "neuraltrade", "user": "smartrisk_user" },
    "redis":    { "host": "localhost", "port": 6379 }
  },
  "docker_service_names": {
    "backend": "django",
    "frontend": "frontend",
    "database": "db",
    "redis": "redis",
    "nginx": "nginx"
  },
  "environment_files": {
    "backend": ".env",
    "frontend": ".env.local",
    "note": "Use .env NOT .env.production; use docker-compose.yml NOT docker-compose.prod.yml"
  },
  "common_commands": {
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "rebuild": "docker-compose up -d --build",
    "logs": "docker-compose logs -f django",
    "migrate": "docker-compose exec django python manage.py migrate",
    "shell": "docker-compose exec django python manage.py shell",
    "backfill": "docker-compose exec django python backfill_signals.py"
  },
  "post_deploy_when_sl_target_changed": "sudo docker-compose exec django python backfill_signals.py"
}