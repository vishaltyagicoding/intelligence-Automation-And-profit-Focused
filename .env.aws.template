# ============================================================================
# AWS Production Environment Variables Template
# ============================================================================
# Copy this file to AWS Secrets Manager or ECS Task Definition
# Replace all placeholder values with actual production values
# ============================================================================

# ============================================================================
# Django Settings
# ============================================================================
SECRET_KEY=<GENERATE_STRONG_SECRET_KEY_50_CHARS_MIN>
DEBUG=False
ALLOWED_HOSTS=<YOUR_DOMAIN>,<ALB_DNS_NAME>,localhost

# ============================================================================
# Database (RDS PostgreSQL)
# ============================================================================
DB_NAME=neuraltrade
DB_USER=neuraltrade_admin
DB_PASSWORD=<STRONG_RDS_PASSWORD>
DB_HOST=<RDS_ENDPOINT>
DB_PORT=5432

# ============================================================================
# Redis (ElastiCache)
# ============================================================================
REDIS_HOST=<ELASTICACHE_ENDPOINT>
REDIS_PORT=6379
REDIS_DB=0

# ============================================================================
# Celery
# ============================================================================
CELERY_BROKER_URL=redis://<ELASTICACHE_ENDPOINT>:6379/1
CELERY_RESULT_BACKEND=redis://<ELASTICACHE_ENDPOINT>:6379/2

# ============================================================================
# Trading APIs (Optional - Configure when ready)
# ============================================================================

# Binance API
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Shoonya/Finvasia API
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=

# Delta Exchange API
DELTA_API_KEY=
DELTA_API_SECRET=

# ============================================================================
# Trading Configuration
# ============================================================================
MAX_TRADES_PER_DAY=4
SLIPPAGE_THRESHOLD_CRYPTO=0.0005
SLIPPAGE_THRESHOLD_COMMODITY=0.001

# ============================================================================
# Payment Gateway (Razorpay - Configure when ready)
# ============================================================================
# RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_secret_key
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# Pricing (in INR)
# ============================================================================
MONTHLY_PLAN_PRICE=499
YEARLY_PLAN_PRICE=4999

# ============================================================================
# JWT Settings (3-day persistent login)
# ============================================================================
JWT_ACCESS_TOKEN_LIFETIME=3
JWT_REFRESH_TOKEN_LIFETIME=7

# ============================================================================
# Monitoring (Optional)
# ============================================================================
SENTRY_DSN=

# ============================================================================
# Frontend Environment Variables
# ============================================================================
# These should be set in ECS Task Definition for frontend container

# Leave empty to use relative URLs (recommended for production)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Or set to your domain
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# ============================================================================
# AWS-Specific Settings
# ============================================================================
AWS_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=<S3_BUCKET_NAME>
AWS_S3_CUSTOM_DOMAIN=<CLOUDFRONT_DOMAIN>

# ============================================================================
# Security Settings
# ============================================================================
ENCRYPTION_KEY=<GENERATE_STRONG_ENCRYPTION_KEY>
KILL_SWITCH_ENABLED=True
KILL_SWITCH_LATENCY_THRESHOLD=500

# ============================================================================
# How to Generate Strong Keys
# ============================================================================
# SECRET_KEY (50+ characters):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# ENCRYPTION_KEY (32 bytes, base64 encoded):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Strong Password:
#   openssl rand -base64 32
# ============================================================================
