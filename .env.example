# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=neuraltrade
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Binance API
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret

# Shoonya/Finvasia API
SHOONYA_USER_ID=your-user-id
SHOONYA_PASSWORD=your-password
SHOONYA_TOTP_SECRET=your-totp-secret
SHOONYA_VENDOR_CODE=your-vendor-code
SHOONYA_API_KEY=your-api-key
SHOONYA_IMEI=your-imei

# Delta Exchange API (NEW!)
DELTA_API_KEY=your-delta-api-key
DELTA_API_SECRET=your-delta-api-secret

# Trading Configuration
MAX_TRADES_PER_DAY=4
SLIPPAGE_THRESHOLD_CRYPTO=0.0005
SLIPPAGE_THRESHOLD_COMMODITY=0.001

# Monitoring
SENTRY_DSN=your-sentry-dsn
